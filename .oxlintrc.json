{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "plugins": ["typescript", "import", "node"],
  "jsPlugins": ["oxlint-plugin-effect/plugin", "./apps/desktop/lint/solid-audit.ts"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "import/no-duplicates": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],
    "node/no-process-env": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-underscore-dangle": "off",
    "no-shadow": "off",
    "no-nested-ternary": "off",
    "complexity": ["error", 50],
    "typescript/consistent-return": "off",
    "effect/noDynamicImports": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/scripts/**",
    "**/bin/**",
    "**/outputs/**",
    "**/src-tauri/**"
  ],
  "overrides": [
    {
      "files": ["**/packages/web/src/**"],
      "rules": {
        "import/no-self-import": "off",
        "import/namespace": "off"
      }
    },
    {
      "files": ["**/apps/desktop/src/**"],
      "rules": {
        "solid/effect-service-no-setters": "error",
        "solid/no-double-nullable": "error",
        "solid/no-effect-as-memo": "error",
        "solid/no-runpromise-then-set": "error",
        "solid/no-paired-bool-state": "error",
        "solid/component-max-loc": ["error", 1000],
        "solid/runpromise-needs-cleanup": "error",
        "solid/no-pushup-loader-component": "error",
        "solid/no-hand-rolled-debounce": "error"
      }
    },
    {
      "files": [
        "**/packages/core/src/local-first/**",
        "**/packages/core/src/procedure/**",
        "**/packages/core/src/reading-preferences/**",
        "**/packages/app/src/procedure/**",
        "**/apps/web/src/workers/user-state-database.ts",
        "**/apps/web/src/workers/procedure-client.ts",
        "**/apps/web/src/workers/procedure-worker-protocol.ts",
        "**/apps/web/src/workers/procedure-server.ts",
        "**/apps/web/src/workers/worker-sql-client.ts",
        "**/apps/desktop/electron/user-state-database.ts",
        "**/apps/desktop/electron/local-procedure-runtime.ts",
        "**/apps/desktop/electron/procedure-server.ts",
        "**/apps/desktop/src/procedure-client.ts",
        "**/apps/desktop/src/procedure-client-protocol.ts",
        "**/apps/desktop/src/procedure-port.ts",
        "**/apps/desktop/shared/procedure-channel.ts"
      ],
      "rules": {
        "effect/noAsyncFunction": "error",
        "effect/noDynamicImports": "error",
        "effect/noEffectBind": "error",
        "effect/noEffectDo": "error",
        "effect/noGlobals": "error",
        "effect/noNewError": "error",
        "effect/noNewPromise": "error",
        "effect/noNodeBuiltinImport": "error",
        "effect/noTernary": "error",
        "effect/noThrowStatement": "error",
        "effect/noTryCatch": "error"
      }
    },
    {
      "files": [
        "**/packages/core/src/local-first/*-bun.ts",
        "**/packages/core/src/local-first/database.ts"
      ],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off"
      }
    },
    {
      "files": ["**/apps/web/src/workers/user-state-database.ts"],
      "rules": {
        "effect/noAsyncFunction": "off"
      }
    },
    {
      "files": ["**/tests/**", "**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "node/no-process-env": "off",
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off",
        "effect/noTryCatch": "off"
      }
    },
    {
      "files": ["**/apps/web/src/index.tsx", "**/apps/desktop/tests/motion-reduced-motion.test.ts"],
      "rules": {
        "effect/noDynamicImports": "off"
      }
    },
    {
      "files": [
        "**/scripts/**",
        "**/packages/core/src/sync/**",
        "**/packages/cli/src/main.ts",
        "**/packages/cli/src/instrumentation/**",
        "**/packages/cli/src/services/logger.ts",
        "**/packages/cli/src/services/model.ts",
        "**/packages/cli/src/lib/paths.ts",
        "**/packages/cli/src/tui/themes/**",
        "**/apps/web/server/main.ts",
        "**/apps/web/e2e/**",
        "**/packages/core/src/egw/auth.ts",
        "**/packages/core/src/egw/client.ts",
        "**/packages/core/src/egw-db/book-database.ts",
        "**/packages/core/src/egw-db/book-database-bun.ts",
        "**/packages/core/src/bible-db/bible-database.ts",
        "**/packages/core/src/hymnal/database.ts",
        "**/packages/core/src/gemini/client.ts"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/packages/core/src/gemini/client.ts",
        "**/packages/core/src/egw/client.ts",
        "**/packages/core/src/egw-db/book-database.ts",
        "**/packages/core/src/bible-db/bible-database.ts",
        "**/packages/core/src/hymnal/**",
        "**/packages/core/src/cache/**",
        "**/packages/core/src/ai/**",
        "**/packages/core/src/egw-gemini/**",
        "**/packages/core/src/structural-analysis/**",
        "**/packages/core/src/sync/**",
        "**/packages/core/src/utils/match.ts",
        "**/apps/web/src/workers/**",
        "**/apps/web/src/lib/cached-app.ts",
        "**/apps/web/src/data/**",
        "**/apps/web/src/providers/**",
        "**/apps/web/src/components/**",
        "**/apps/web/src/routes/**",
        "**/packages/test-utils/**",
        "**/packages/cli/src/lib/**",
        "**/packages/cli/src/data/**",
        "**/packages/cli/src/services/**",
        "**/packages/cli/src/commands/**",
        "**/packages/cli/src/tui/**",
        "**/apps/desktop/electron/**"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/apps/web/**/*.tsx", "**/apps/web/**/*.ts"],
      "rules": {
        "typescript/no-floating-promises": "off",
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": [
        "**/packages/core/src/egw-reader/**",
        "**/packages/core/src/app/**",
        "**/packages/cli/src/tui/context/**"
      ],
      "rules": {
        "typescript/no-misused-spread": "off"
      }
    }
  ]
}
