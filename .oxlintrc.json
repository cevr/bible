{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "plugins": ["typescript", "import", "node"],
  "jsPlugins": ["oxlint-plugin-effect/plugin", "./packages/film/lint/plugin.ts"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "import/no-duplicates": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],
    "node/no-process-env": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-underscore-dangle": "off",
    "no-shadow": "off",
    "no-nested-ternary": "off",
    "complexity": ["error", { "max": 21 }],
    "effect/maxCognitiveComplexity": ["error", { "max": 21 }],
    "effect/maxHalsteadDifficulty": ["error", { "max": 79 }],
    "typescript/consistent-return": "off",
    "effect/noInlineProvide": "error",
    "effect/noManagedRuntimeInEffect": "error",
    "effect/noModuleMocks": "error",
    "effect/noNestedEffectGen": "error",
    "effect/noPerCallCacheConstruction": "error",
    "effect/noRunCollectOnUnboundedStream": "error",
    "effect/noSequentialEffectAll": "error",
    "effect/noSilentCatchAll": "error",
    "effect/noUnboundedConcurrency": "error",
    "effect/noUnboundedRetry": "error",
    "effect/preferCatchTag": "error",
    "effect/preferMatchTagsExhaustive": "error",
    "effect/preferPredicateIsTagged": "error",
    "effect/preferServiceOf": "error",
    "effect/requireNamedEffectFn": "error",
    "effect/noAs": "error",
    "effect/noAsyncFunction": "error",
    "effect/noChainedTypeAssertions": "error",
    "effect/noConditionalEmptyObjectSpread": "error",
    "effect/noDynamicImports": "error",
    "effect/noEffectBind": "error",
    "effect/noEffectDo": "error",
    "effect/noGlobals": "error",
    "effect/noKnownValueWidening": "error",
    "effect/noNewError": "error",
    "effect/noNewPromise": "error",
    "effect/noNodeBuiltinImport": "error",
    "effect/noNullish": "error",
    "effect/noObjectParameters": "error",
    "effect/noRuntimeTypeof": "error",
    "effect/noShapeInSymbolNames": "error",
    "effect/noTernary": "error",
    "effect/noTestLifecycleHooks": "error",
    "effect/noThrowStatement": "error",
    "effect/noTryCatch": "error",
    "effect/noUnknownParameters": "error",
    "effect/noUnknownTypeAliases": "error",
    "effect/noUnsafeDictionaryType": "error",
    "effect/noWidenThenAssert": "error",
    "effect/preferEffectFn": "error",
    // A test waits on the event it asserts (a Deferred, a Latch, a condition
    // wait), never a fixed time: under load the fixed wait guesses wrong.
    "effect/noFixedWaitInTests": "error"
  },
  // Test code besides `*.test.*` and `*.spec.*` modules: the harness helpers
  // the fixed-wait rule and effect's other test-aware rules read as tests.
  "settings": {
    "effect": {
      "testFiles": ["**/fixtures/**", "**/test/**", "**/tests/**", "**/e2e/**"]
    }
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/*.d.ts",
    "**/outputs/**",
    "**/lint/fixtures/**",
    "**/.alchemy/**",
    "apps/triedgold/build/**",
    "apps/triedgold/.react-router/**"
  ],
  "overrides": [
    {
      "files": ["**/packages/core/src/**/*.ts", "**/packages/core/src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "bun:*",
                  "@effect/platform-bun",
                  "@effect/platform-bun/*",
                  "@effect/sql-sqlite-bun",
                  "@effect/sql-sqlite-bun/*"
                ],
                "message": "Portable core modules must use Effect interfaces. Put host code in an explicit adapter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/packages/core/src/**/*-bun.ts",
        "**/packages/core/src/platform-bun/**",
        "**/packages/core/src/sync/**",
        "**/packages/core/src/**/*.test.ts",
        "**/packages/core/src/**/*.test.tsx",
        "**/packages/core/src/**/*.spec.ts",
        "**/packages/core/src/**/*.spec.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/packages/core/src/egw/build-defines.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noTernary": "off"
      }
    },
    {
      "files": ["**/apps/egw-search/server/main.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["**/packages/cli/src/services/process.ts"],
      "rules": {
        "effect/noGlobals": "off"
      }
    },
    {
      // Standalone Bun maintenance scripts: the Keynote deck pipeline and the
      // corpus scripts under `packages/cli/scripts/`. They import no Effect at
      // all — each is a top-level-await entry point that shells out to `sips`,
      // `osascript` and the `bible` CLI, or talks to the content API over
      // `fetch` and writes SQLite through `bun:sqlite`, then reports to stdout.
      // Holding them to the Effect rules would mean wrapping a shell pipeline
      // or a one-shot migration in a runtime and a layer stack that buys
      // nothing — the host boundary *is* the whole program here.
      "files": ["**/skills/bible/scripts/**/*.ts", "**/packages/cli/scripts/**/*.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "effect/noAs": "off",
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off"
      }
    },
    {
      // The film draw path: the Canvas 2D kit and each film's scenes and props.
      // A frame is a pure function of time drawn thousands of times per render,
      // so it keeps plain arithmetic: ternaries and `?? default` for optional
      // geometry, and short shape names (`pts`, `rim`). Every other rule
      // applies, `throw` included: a film never throws. The tools and the
      // Schema/data modules of packages/film are not listed here and get the
      // full rule set.
      "files": ["**/packages/film/src/canvas/**/*.ts", "**/apps/animations/src/films/**/*.ts"],
      "rules": {
        "effect/noNullish": "off",
        "effect/noShapeInSymbolNames": "off",
        "effect/noTernary": "off"
      }
    },
    {
      // The procedural synth's sample loops (packages/film/src/core/synth):
      // typed arrays indexed with `?? 0` and per-sample branches, as the mix's
      // dsp.ts and audio.ts. Recipes stay pure functions of their seed.
      "files": ["**/packages/film/src/core/synth/**/*.ts"],
      "rules": {
        "effect/noNullish": "off",
        "effect/noTernary": "off"
      }
    },
    {
      // The easing helpers the draw path calls every frame: ternaries and
      // `?? default` as the draw path, nothing else.
      "files": ["**/packages/film/src/core/time.ts"],
      "rules": {
        "effect/noNullish": "off",
        "effect/noTernary": "off"
      }
    },
    {
      // The engine's thrown Errors: a programming mistake (a film with no
      // scenes, a missing cue, knob or mark, no 2d context, a colour that is
      // not hex) that must stop the render. They live in the engine, never in
      // a film; the probe test throws inside a draw to prove the probe comes
      // off.
      "files": [
        "**/packages/film/src/canvas/colour.ts",
        "**/packages/film/src/canvas/film.ts",
        "**/packages/film/src/canvas/paper.ts",
        "**/packages/film/src/canvas/probe.test.ts"
      ],
      "rules": {
        "effect/noNewError": "off",
        "effect/noThrowStatement": "off"
      }
    },
    {
      // Context-scoped draw state (the check's probe, a cutout's shadow
      // height): each attaches to a canvas context for one synchronous draw,
      // and must come off even when the draw throws (else the next frame
      // inherits a failed frame's state). The draw path runs no Effect, so a
      // plain try/finally is the release.
      "files": ["**/packages/film/src/canvas/probe.ts", "**/packages/film/src/canvas/cutout.ts"],
      "rules": {
        "effect/noTryCatch": "off"
      }
    },
    {
      // The film clock, read by the draw path every frame and by the tools:
      // `layout` places scenes, `narration` times words, `timeline` resolves
      // named cues. The clock returns Results; the draw path's reads stay
      // plain optionals and ternaries.
      "files": [
        "**/packages/film/src/core/layout.ts",
        "**/packages/film/src/core/narration.ts",
        "**/packages/film/src/core/timeline.ts"
      ],
      "rules": {
        "effect/noNullish": "off",
        "effect/noTernary": "off"
      }
    },
    {
      // The mix's sample loops: planar PCM, and the fade, duck and limiter
      // that keep libavfilter's arithmetic, run over every sample of a film's
      // track. They index typed arrays with
      // `?? 0` (past an array's end is silence) and branch per sample with
      // ternaries, as the draw path does.
      "files": ["**/packages/film/src/core/audio.ts", "**/packages/film/src/core/dsp.ts"],
      "rules": {
        "effect/noNullish": "off",
        "effect/noTernary": "off"
      }
    },
    {
      // The `film` plugin's guardrails (packages/film/lint/), on every film.
      "files": ["**/apps/animations/src/films/**/*.ts"],
      "rules": {
        "film/drawing-literal": "error",
        "film/no-hand-timed-seconds": "error",
        "film/no-unprobed-ink": "error",
        "film/span-ends-on-anchor": "error",
        "film/no-ease-on-cue": "error",
        // A part of a cue is a cue of its own, never clamp(f.at(cue) * k).
        "film/no-cue-remap": "error"
      }
    },
    {
      // A scene's framing is knobs; a framing shared across scenes lives in a set file.
      "files": ["**/apps/animations/src/films/*/scenes/*.ts"],
      "rules": {
        "film/framing-is-a-knob": "error"
      }
    },
    {
      // Over all of packages/film and apps/animations: a variadic logger handed
      // point-free to a callback passed an index prints the index after each
      // line (packages/film/lint/no-point-free-log.ts).
      "files": [
        "**/packages/film/**/*.ts",
        "**/packages/film/**/*.tsx",
        "**/apps/animations/**/*.ts",
        "**/apps/animations/**/*.tsx"
      ],
      "rules": {
        "film/no-point-free-log": "error",
        // A comment says today's behaviour and its reason, never how the code
        // got here (packages/film/lint/no-history-comment.ts).
        "film/no-history-comment": "error"
      }
    },
    {
      // The purity rule (packages/film/README.md): core imports none of the
      // film's other layers, and the engine neither the player nor the tools.
      "files": ["**/packages/film/src/core/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/canvas/**",
                  "**/player/**",
                  "**/tools/**",
                  "**/lab/**",
                  "@bible/film/*"
                ],
                "message": "core never imports canvas, player, tools or lab: they import it (packages/film/README.md, the purity rule)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/packages/film/src/canvas/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/player/**",
                  "**/tools/**",
                  "**/lab/**",
                  "@bible/film/player",
                  "@bible/film/tools",
                  "@bible/film/lab"
                ],
                "message": "the engine never imports the player, tools or lab: they import it (packages/film/README.md, the purity rule)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/packages/film/src/player/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/tools/**", "**/lab/**", "@bible/film/tools", "@bible/film/lab"],
                "message": "the player never imports the tools or the lab: the lab mounts the player (packages/film/README.md, the purity rule)."
              }
            ]
          }
        ]
      }
    },
    {
      // A lab browser test waits for the value it asserts, never reads the
      // page once (packages/film/lint/no-read-once.ts, lab/fixtures/settled.ts).
      "files": ["**/*.dom.test.ts"],
      "rules": {
        "film/no-read-once": "error"
      }
    },
    {
      // A test that spawns a process declares its timeout (packages/film/lint/spawn-budget.ts).
      "files": ["**/packages/film/**/*.test.ts"],
      "rules": {
        "film/spawn-budget": "error"
      }
    },
    {
      // A film's scene registry builds each SceneSpec with its optional `say`.
      "files": ["**/apps/animations/src/films/*/scenes/index.ts"],
      "rules": {
        "effect/noConditionalEmptyObjectSpread": "off"
      }
    },
    {
      // The browser player: DOM, audio element and requestAnimationFrame, plus
      // the `?export` handle the renderer drives through page.evaluate.
      "files": ["**/packages/film/src/player/**/*.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNullish": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      // The dev server: Bun.serve over the app's files.
      "files": ["**/apps/animations/server.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTernary": "off"
      }
    },
    {
      "files": ["**/tests/**", "**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "node/no-process-env": "off",
        "effect/noAs": "off",
        "effect/noChainedTypeAssertions": "off",
        "effect/noWidenThenAssert": "off"
      }
    },
    {
      "files": [
        "**/scripts/**",
        "**/packages/core/src/sync/**",
        "**/packages/cli/src/main.ts",
        "**/packages/cli/src/instrumentation/**",
        "**/packages/cli/src/services/logger.ts",
        "**/packages/cli/src/lib/paths.ts",
        "**/packages/core/src/egw/auth.ts",
        "**/packages/core/src/egw/client.ts",
        "**/packages/core/src/egw-db/book-database.ts",
        "**/packages/core/src/egw-db/book-database-bun.ts",
        "**/packages/core/src/bible-db/bible-database.ts"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/packages/core/src/egw/client.ts",
        "**/packages/core/src/egw-db/book-database.ts",
        "**/packages/core/src/bible-db/bible-database.ts",
        "**/packages/core/src/hymnal/**",
        "**/packages/core/src/sync/**",
        "**/packages/cli/src/lib/**",
        "**/packages/cli/src/data/**",
        "**/packages/cli/src/services/**",
        "**/packages/cli/src/commands/**"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "effect/noAs": "off",
        "effect/noChainedTypeAssertions": "off",
        "effect/noWidenThenAssert": "off"
      }
    }
  ]
}
