{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "plugins": ["typescript", "import", "node"],
  "jsPlugins": ["oxlint-plugin-effect/plugin"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-non-null-asserted-optional-chain": "error",
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "import/no-duplicates": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/*.scss"] }],
    "node/no-process-env": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-underscore-dangle": "off",
    "no-shadow": "off",
    "no-nested-ternary": "off",
    "complexity": ["error", 50],
    "typescript/consistent-return": "off",
    "effect/noInlineProvide": "error",
    "effect/noManagedRuntimeInEffect": "error",
    "effect/noModuleMocks": "error",
    "effect/noNestedEffectGen": "error",
    "effect/noPerCallCacheConstruction": "error",
    "effect/noRunCollectOnUnboundedStream": "error",
    "effect/noSequentialEffectAll": "error",
    "effect/noSilentCatchAll": "error",
    "effect/noUnboundedConcurrency": "error",
    "effect/noUnboundedRetry": "error",
    "effect/preferCatchTag": "error",
    "effect/preferMatchTagsExhaustive": "error",
    "effect/preferPredicateIsTagged": "error",
    "effect/preferServiceOf": "error",
    "effect/requireNamedEffectFn": "error",
    "effect/noAs": "error",
    "effect/noAsyncFunction": "error",
    "effect/noChainedTypeAssertions": "error",
    "effect/noConditionalEmptyObjectSpread": "error",
    "effect/noDynamicImports": "error",
    "effect/noEffectBind": "error",
    "effect/noEffectDo": "error",
    "effect/noGlobals": "error",
    "effect/noKnownValueWidening": "error",
    "effect/noNewError": "error",
    "effect/noNewPromise": "error",
    "effect/noNodeBuiltinImport": "error",
    "effect/noNullish": "error",
    "effect/noObjectParameters": "error",
    "effect/noRuntimeTypeof": "error",
    "effect/noShapeInSymbolNames": "error",
    "effect/noTernary": "error",
    "effect/noTestLifecycleHooks": "error",
    "effect/noThrowStatement": "error",
    "effect/noTryCatch": "error",
    "effect/noUnknownParameters": "error",
    "effect/noUnknownTypeAliases": "error",
    "effect/noUnsafeDictionaryType": "error",
    "effect/noWidenThenAssert": "error",
    "effect/preferEffectFn": "error"
  },
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.d.ts", "**/outputs/**"],
  "overrides": [
    {
      "files": ["**/packages/core/src/**/*.ts", "**/packages/core/src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "bun:*",
                  "electron",
                  "electron/*",
                  "better-sqlite3",
                  "wa-sqlite",
                  "wa-sqlite/*",
                  "@effect/platform-bun",
                  "@effect/platform-bun/*",
                  "@effect/platform-node",
                  "@effect/platform-node/*",
                  "@effect/platform-browser",
                  "@effect/platform-browser/*",
                  "@effect/sql-sqlite-bun",
                  "@effect/sql-sqlite-bun/*",
                  "@effect/sql-sqlite-node",
                  "@effect/sql-sqlite-node/*"
                ],
                "message": "Portable core modules must use Effect interfaces. Put host code in an explicit adapter."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/packages/core/src/**/*-bun.ts",
        "**/packages/core/src/**/*-node.ts",
        "**/packages/core/src/**/*-browser.ts",
        "**/packages/core/src/platform-bun/**",
        "**/packages/core/src/platform-node/**",
        "**/packages/core/src/platform-browser/**",
        "**/packages/core/src/sync/**",
        "**/packages/core/src/**/*.test.ts",
        "**/packages/core/src/**/*.test.tsx",
        "**/packages/core/src/**/*.spec.ts",
        "**/packages/core/src/**/*.spec.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/packages/web/src/**"],
      "rules": {
        "import/no-self-import": "off",
        "import/namespace": "off"
      }
    },
    {
      "files": ["**/packages/core/src/egw/build-defines.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noTernary": "off"
      }
    },
    {
      "files": ["**/packages/web/src/server.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTryCatch": "off"
      }
    },
    {
      "files": ["**/apps/egw-search/server/main.ts"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": ["**/packages/cli/src/services/process.ts"],
      "rules": {
        "effect/noGlobals": "off"
      }
    },
    {
      // Standalone Bun maintenance scripts: the Keynote deck pipeline and the
      // corpus scripts under `packages/cli/scripts/`. They import no Effect at
      // all — each is a top-level-await entry point that shells out to `sips`,
      // `osascript` and the `bible` CLI, or talks to the content API over
      // `fetch` and writes SQLite through `bun:sqlite`, then reports to stdout.
      // Holding them to the Effect rules would mean wrapping a shell pipeline
      // or a one-shot migration in a runtime and a layer stack that buys
      // nothing — the host boundary *is* the whole program here.
      "files": ["**/skills/bible/scripts/**/*.ts", "**/packages/cli/scripts/**/*.ts"],
      "rules": {
        "no-await-in-loop": "off",
        "effect/noAs": "off",
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noNullish": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off"
      }
    },
    {
      // The film draw path: the Canvas 2D kit, each film's scenes and props, and
      // the easing and seeded-noise helpers they call. A frame is a pure
      // function of time drawn thousands of times per render, so it keeps plain
      // arithmetic: ternaries and `?? default` for optional geometry, short
      // shape names (`pts`, `rim`), and a thrown Error for a programming
      // mistake (a missing cue, an unknown mark) that must stop the render.
      // Every other rule applies. The tools and the Schema/data modules of
      // packages/film are not listed here and get the full rule set.
      "files": [
        "**/packages/film/src/canvas/**/*.ts",
        "**/packages/film/src/core/time.ts",
        "**/packages/film/src/core/random.ts",
        "**/apps/animations/src/films/**/*.ts"
      ],
      "rules": {
        "effect/noNewError": "off",
        "effect/noNullish": "off",
        "effect/noShapeInSymbolNames": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off"
      }
    },
    {
      // The check's probe, on the draw path: it attaches to a canvas context
      // for one synchronous draw, and must come off even when the draw throws
      // (else the next frame records into a failed frame's list). The draw
      // path runs no Effect, so a plain try/finally is the release.
      "files": ["**/packages/film/src/canvas/probe.ts"],
      "rules": {
        "effect/noTryCatch": "off"
      }
    },
    {
      // The film clock, read by the draw path every frame and by the tools:
      // `layout` places scenes, `narration` times words, `timeline` resolves
      // named cues. Optional scene fields stay plain optionals, and a layout
      // mistake throws so the player and renderer stop; the tools lift that
      // throw into LayoutInvalid at their boundary (tools/film-repo.ts).
      "files": [
        "**/packages/film/src/core/layout.ts",
        "**/packages/film/src/core/narration.ts",
        "**/packages/film/src/core/timeline.ts"
      ],
      "rules": {
        "effect/noNewError": "off",
        "effect/noNullish": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off"
      }
    },
    {
      // Planar PCM, sample by sample: typed arrays indexed with `?? 0` (past
      // an array's end is silence) and a branch per sample, as the draw path does.
      "files": ["**/packages/film/src/core/audio.ts"],
      "rules": {
        "effect/noNullish": "off",
        "effect/noTernary": "off"
      }
    },
    {
      // A film's scene registry builds each SceneSpec with its optional `say`.
      "files": ["**/apps/animations/src/films/*/scenes/index.ts"],
      "rules": {
        "effect/noConditionalEmptyObjectSpread": "off"
      }
    },
    {
      // A film's browser loader: fetches its timings and builds the film.
      "files": ["**/apps/animations/src/films/*/film.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off"
      }
    },
    {
      // The browser player: DOM, audio element and requestAnimationFrame, plus
      // the `?export` handle the renderer drives through page.evaluate.
      "files": ["**/packages/film/src/player/**/*.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNewError": "off",
        "effect/noNewPromise": "off",
        "effect/noNullish": "off",
        "effect/noTernary": "off",
        "effect/noThrowStatement": "off",
        "effect/noUnknownParameters": "off"
      }
    },
    {
      // The dev server: Bun.serve over the app's files.
      "files": ["**/apps/animations/server.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTernary": "off"
      }
    },
    {
      "files": ["**/apps/web/src/workers/sqlite-host.ts"],
      "rules": {
        "effect/noAsyncFunction": "off"
      }
    },
    {
      "files": ["**/apps/web/src/workers/database-file-downloader.ts"],
      "rules": {
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["**/apps/web/src/workers/db-worker-host.ts"],
      "rules": {
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["**/apps/web/src/workers/database-worker.ts"],
      "rules": {
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["**/apps/web/e2e/smoke.spec.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["**/apps/web/e2e/playwright.config.ts", "**/apps/desktop/e2e/playwright.config.ts"],
      "rules": {
        "effect/noGlobals": "off"
      }
    },
    {
      "files": ["**/apps/desktop/e2e/smoke.spec.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off",
        "effect/noTryCatch": "off"
      }
    },
    {
      "files": ["**/apps/desktop/electron/main.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off"
      }
    },
    {
      "files": ["**/apps/web/server/main.ts"],
      "rules": {
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off"
      }
    },
    {
      "files": ["**/apps/desktop/scripts/vite-plugin-electron-dev.ts"],
      "rules": {
        "effect/noAsyncFunction": "off",
        "effect/noGlobals": "off",
        "effect/noNodeBuiltinImport": "off"
      }
    },
    {
      "files": ["**/apps/desktop/electron/user-state-generation-host.ts"],
      "rules": {
        "effect/noNodeBuiltinImport": "off"
      }
    },
    {
      "files": ["**/tests/**", "**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "node/no-process-env": "off",
        "effect/noAs": "off",
        "effect/noChainedTypeAssertions": "off",
        "effect/noWidenThenAssert": "off"
      }
    },
    {
      "files": [
        "**/scripts/**",
        "**/packages/core/src/sync/**",
        "**/packages/cli/src/main.ts",
        "**/packages/cli/src/instrumentation/**",
        "**/packages/cli/src/services/logger.ts",
        "**/packages/cli/src/lib/paths.ts",
        "**/apps/web/server/main.ts",
        "**/apps/web/e2e/**",
        "**/packages/core/src/egw/auth.ts",
        "**/packages/core/src/egw/client.ts",
        "**/packages/core/src/egw-db/book-database.ts",
        "**/packages/core/src/egw-db/book-database-bun.ts",
        "**/packages/core/src/bible-db/bible-database.ts"
      ],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/packages/core/src/egw/client.ts",
        "**/packages/core/src/egw-db/book-database.ts",
        "**/packages/core/src/bible-db/bible-database.ts",
        "**/packages/core/src/hymnal/**",
        "**/packages/core/src/sync/**",
        "**/apps/web/src/workers/**",
        "**/packages/test-utils/**",
        "**/packages/cli/src/lib/**",
        "**/packages/cli/src/data/**",
        "**/packages/cli/src/services/**",
        "**/packages/cli/src/commands/**",
        "**/apps/desktop/electron/**"
      ],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off",
        "effect/noAs": "off",
        "effect/noChainedTypeAssertions": "off",
        "effect/noWidenThenAssert": "off"
      }
    }
  ]
}
