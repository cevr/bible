{
  "name": "bible",
  "version": "1.0.0",
  "private": true,
  "description": "bible",
  "license": "MIT",
  "author": "cristian ramos <seeve.c@gmail.com>",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:topics": "bun run --cwd packages/scripts build:topics",
    "build:vectors": "bun run --cwd packages/scripts build:vectors",
    "dev:egw-search": "agent-tail run --log-dir tmp/logs 'web: bun run --cwd apps/egw-search vite:dev' 'api: bun run --cwd apps/egw-search server:dev'",
    "typecheck": "turbo run typecheck",
    "lint": "bun run lint:judged && bun packages/scripts/src/lint.ts --report-unused-disable-directives-severity=error",
    "lint:fix": "bun packages/scripts/src/lint.ts --fix",
    "lint:judged": "bun --no-env-file packages/scripts/src/lint-judged.ts",
    "logs": "agent-tail tail --log-dir tmp/logs -n 200",
    "logs:errors": "rg -n -i '\\[console\\.(error|warn)\\]|\\b(ERROR|WARN)\\b|\\[[^]]+\\] [^ ]*(failed|failure)\\b|uncaught|unhandled|defect' tmp/logs/latest/combined.log || true",
    "logs:follow": "agent-tail tail --log-dir tmp/logs -f",
    "fmt": "bun packages/scripts/src/fmt.ts",
    "fmt:check": "bun packages/scripts/src/fmt.ts --check",
    "test": "turbo run test",
    "test:e2e": "bun run --cwd packages/film test:e2e",
    "test:e2e:check": "bun run --cwd packages/film test:e2e:check",
    "test:perf": "turbo run test:perf --concurrency=1",
    "test:budget": "bun packages/scripts/src/test-budget.ts",
    "gate": "sh packages/scripts/src/gate.sh",
    "gate:checks": "concurrently -g -n lint,fmt,dead-exports,turbo \"bun run lint\" \"bun run fmt:check\" \"bun run dead-exports\" \"turbo run gate\"",
    "gate:tests": "turbo run gate:timed test --concurrency=1 --filter=!@bible/selah; t=$?; bun run --cwd packages/film test:guard && exit $t",
    "guard": "concurrently -g -n lint,fmt,dead-exports,film \"nice -n 10 bun run lint\" \"nice -n 10 bun run fmt:check\" \"nice -n 10 bun run dead-exports\" \"bun run --cwd packages/film test:guard\"",
    "dead-exports": "bun packages/scripts/src/dead-exports.ts",
    "merge-audit": "bun packages/scripts/src/merge-audit.ts",
    "redfirst": "bun packages/scripts/src/redfirst.ts",
    "doc-lines": "bun packages/film/src/fixtures/doc-lines.ts",
    "gate:fix": "bun run lint:fix && bun run fmt && bun run gate",
    "clean": "rm -rf .turbo */.turbo */*/.turbo",
    "prepare": "(test -d .git && lefthook install || true) && effect-tsgo patch --force"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.51.1",
    "@types/bun": "1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "agent-tail-core": "^0.4.0",
    "concurrently": "^10.0.6",
    "effect": "catalog:",
    "effect-bun-test": "0.5.0",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-plugin-effect": "0.29.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.2",
    "@react-navigation/bottom-tabs": "8.0.0-alpha.57",
    "@react-navigation/core": "8.0.0-alpha.41",
    "@react-navigation/drawer": "8.0.0-alpha.58",
    "@react-navigation/elements": "3.0.0-alpha.55",
    "@react-navigation/native": "8.0.0-alpha.51",
    "@react-navigation/native-stack": "8.0.0-alpha.59",
    "@react-navigation/routers": "8.0.0-alpha.21",
    "effect": "4.0.2"
  },
  "packageManager": "bun@1.4.3",
  "catalog": {
    "@effect/ai-typesafe": "4.0.2",
    "@effect/atom-react": "4.0.2",
    "@effect/platform-bun": "4.0.2",
    "@effect/platform-node": "4.0.2",
    "@effect/platform-node-shared": "4.0.2",
    "@effect/sql-d1": "4.0.2",
    "@effect/sql-sqlite-bun": "4.0.2",
    "@effect/vitest": "4.0.2",
    "@solidjs/compiler": "2.0.0-rc.15",
    "@solidjs/web": "2.0.0-rc.15",
    "effect": "4.0.2",
    "effect-bun-test": "0.5.0",
    "effect-machine": "0.29.0",
    "solid-js": "2.0.0-rc.15",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
