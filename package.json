{
  "name": "bible",
  "version": "1.0.0",
  "private": true,
  "description": "bible",
  "license": "MIT",
  "author": "cristian ramos <seeve.c@gmail.com>",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:topics": "bun run --cwd packages/scripts build:topics",
    "build:vectors": "bun run --cwd packages/scripts build:vectors",
    "dev:desktop": "agent-tail run --log-dir tmp/logs 'desktop: bun run --cwd apps/desktop vite:dev'",
    "dev:web": "agent-tail run --log-dir tmp/logs 'web: bun run --cwd apps/web vite:dev' 'api: bun run --cwd apps/web server:dev'",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "logs": "agent-tail tail --log-dir tmp/logs -n 200",
    "logs:errors": "rg -n -i '\\[console\\.(error|warn)\\]|\\b(ERROR|WARN)\\b|\\[[^]]+\\] [^ ]*(failed|failure)\\b|uncaught|unhandled|defect' tmp/logs/latest/combined.log || true",
    "logs:follow": "agent-tail tail --log-dir tmp/logs -f",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "turbo run test",
    "test:perf": "turbo run test:perf --concurrency=1",
    "checkpoint": "bun run --cwd packages/scripts checkpoint",
    "gate": "concurrently -n style,turbo -c yellow,cyan \"bun run lint && bun run fmt\" \"turbo run gate\" && bun run test:perf",
    "gate:fix": "bun run lint:fix && bun run fmt && bun run gate",
    "clean": "rm -rf .turbo */.turbo */*/.turbo",
    "prepare": "(test -d .git && lefthook install || true) && effect-tsgo patch"
  },
  "dependencies": {
    "@solid-primitives/refs": "^1.1.4"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.36.4",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "agent-tail-core": "^0.4.0",
    "concurrently": "^10.0.4",
    "effect": "catalog:",
    "effect-bun-test": "0.3.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-plugin-effect": "0.8.2",
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "vite-plugin-agent-tail": "^0.4.0"
  },
  "overrides": {
    "@effect/ai-anthropic": "4.0.0-rc.109",
    "@effect/ai-openai": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/ai-anthropic": "4.0.0-rc.109",
    "@effect/ai-openai": "4.0.0-rc.109",
    "@effect/platform-browser": "4.0.0-rc.109",
    "@effect/platform-bun": "4.0.0-rc.109",
    "@effect/platform-node": "4.0.0-rc.109",
    "@effect/sql-sqlite-bun": "4.0.0-rc.109",
    "@effect/sql-sqlite-node": "4.0.0-rc.109",
    "@effect/vitest": "4.0.0-rc.109",
    "@solidjs/router": "2.0.0-next.16",
    "@solidjs/web": "2.0.0-rc.0",
    "@types/bun": "1.3.14",
    "drizzle-orm": "1.0.0-beta.24",
    "effect": "4.0.0-rc.109",
    "effect-bun-test": "0.3.0",
    "solid-js": "2.0.0-rc.0",
    "vite-plugin-solid": "3.0.0-next.27"
  }
}
