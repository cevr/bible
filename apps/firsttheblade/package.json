{
  "name": "@bible/firsttheblade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr src/prerender.tsx --outDir .prerender && bun .prerender/prerender.js && bun scripts/built.ts",
    "preview": "bun src/worker/preview.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src scripts kit",
    "gate": "bun scripts/promise.ts && bun run promise:census",
    "gate:timed": "bun run contrast",
    "contrast": "bun scripts/contrast.ts",
    "promise": "bun run build && bun scripts/promise.ts",
    "promise:census": "bun scripts/promise-census.ts",
    "kit": "bun kit/draw.ts",
    "kit:field": "bun kit/field.ts",
    "kit:approve": "bun kit/approve.ts",
    "plan": "bun run build && alchemy plan alchemy.run.ts --stage prod",
    "deploy": "bun run build && alchemy deploy alchemy.run.ts --stage prod",
    "mail:send": "bun scripts/mail-send.ts",
    "verify:launch": "bun --no-env-file scripts/verify/cli.ts launch",
    "verify:stop": "bun --no-env-file scripts/verify/cli.ts stop",
    "verify:doctor": "bun --no-env-file scripts/verify/cli.ts doctor",
    "verify:outbox": "bun --no-env-file scripts/verify/cli.ts outbox",
    "verify:drive": "bun --no-env-file scripts/verify/cli.ts drive",
    "verify:stage": "bun --no-env-file scripts/verify/cli.ts stage"
  },
  "dependencies": {
    "@bible/ui": "workspace:*",
    "@solidjs/web": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@playwright/test": "1.64.0",
    "alchemy": "2.0.0-beta.83",
    "effect-bun-test": "catalog:",
    "parse5": "7.3.0",
    "sharp": "0.35.4",
    "vite": "^8.3.4",
    "vite-plugin-solid": "catalog:"
  }
}
