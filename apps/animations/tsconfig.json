{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "infra/**/*.ts",
    "server.ts",
    "cli.ts",
    "alchemy.run.ts"
  ],
  "exclude": ["node_modules", "out"]
}
