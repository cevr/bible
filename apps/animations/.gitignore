# Renders, stills and contact sheets — rebuilt by `bun run render`.
out/
# The mixed track (16-bit WAV) — rebuilt from the committed takes, score and
# effects by `bun run mix`. The player streams it; the renderer encodes from it.
src/films/*/narration/full.wav
# What the track was mixed from (`mixKey`), written beside it by the same mix.
src/films/*/narration/full.json
# Writes in flight: a file lands as `<file>.<pid>-<n>.<host tag>.partial`
# (takes, timings, sound, the mix; `writeWhole`) and is renamed only once whole;
# a crash can leave one, and `narrate` removes the partials whose writer is gone,
# with any take the timings no longer name. A manifest's lock file,
# `.<file>.lock`, stays beside it; the operating system's lock on it is let go
# when its holder exits.
src/films/**/*.partial
src/library/**/*.partial
src/films/**/*.lock
src/library/**/*.lock
src/films/*/narration/*.take.mp3
# Every recording of a person's take (`takes import`, the lab's studio), kept to
# hear again or keep instead: only the take the timings name is committed.
src/films/*/narration/attempts/
# Generated sounds (ElevenLabs): never in this public repo. They sync with the
# private store (`sfx pull` / `sfx push`).
**/sounds/files/
# A film's generated score (ElevenLabs music) likewise: only its manifest
# (hashes) is committed; each option syncs with the same private store.
src/films/*/sound/*
!src/films/*/sound/manifest.json
# A library file in flight (`<file>.<pid>-<n>.<host tag>.partial`, then renamed), and the
# library's lock file, `.library.lock.json.lock`.
**/sounds/**/*.partial
**/sounds/**/*.lock
# Camera footage (the owner's face, licensed stock): never in this public repo.
# The originals sync with the private store (`footage push` / `footage pull`);
# only the lock and the transcripts (text and numbers) are committed. Its
# copies are made under `out/footage/` by `footage make`.
**/footage/files/
**/footage/**/*.partial
**/footage/**/*.lock
# A film's storyboard images (`film board`, `okra image`): big, and made again
# only at a cost. Only the record, `board.json` (each image's sha256), is
# committed; copy the folder between checkouts.
src/films/*/board/
# A cast member's sheet references (`film concept cast`): the same, beside
# their record, `cast-sheet.json`, and the member's `look.md`.
src/library/cast/*/cast-sheet/*.png
src/films/*/cast/*/cast-sheet/*.png
# A version folder (`<film>/v<n>/`, an earlier version kept beside the film)
# keeps the same files out: its board images, its mix and its takes' attempts.
src/films/*/v*/board/
src/films/*/v*/narration/full.wav
src/films/*/v*/narration/full.json
src/films/*/v*/narration/*.take.mp3
src/films/*/v*/narration/attempts/
src/films/*/v*/sound/*
!src/films/*/v*/sound/manifest.json
# The productions' ledgers (`productions/<production>.json`) are committed: small
# text, the owner's decisions. Only a write in flight and the lock file stay out.
productions/*.partial
productions/*.lock
