{
  "name": "@bible/egw-search",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"bun run vite:dev\" \"bun run server:dev\"",
    "vite:dev": "vite",
    "server:dev": "bun --watch server/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production bun server/main.ts",
    "plan": "vite build && alchemy plan alchemy.run.ts --stage prod",
    "deploy": "turbo run test:slow --filter=@bible/egw-search && alchemy deploy alchemy.run.ts --stage prod",
    "test:deploy": "vite build && bun test ./tests/deploy.integration.ts",
    "test:browser": "bun run build && playwright test --config=test/browser/playwright.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='**/*.slow.test.*' src server",
    "test:slow": "bun test .slow.test. && playwright test --config=test/browser/playwright.config.ts"
  },
  "dependencies": {
    "@bible/atom-solid": "workspace:*",
    "@bible/core": "workspace:*",
    "@bible/url-state": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@solidjs/web": "catalog:",
    "effect": "catalog:",
    "marked": "18.0.14",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "@playwright/test": "1.64.0",
    "alchemy": "2.0.0-beta.83",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4",
    "vite-plugin-solid": "catalog:"
  }
}
