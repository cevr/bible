# The EGW Search build context, `apps/egw-search/.deploy` (`./context.ts`).
# `turbo prune` already left out everything git ignores: node_modules, build
# output, local state and secrets. This file removes the tracked files the
# image does not need. Alchemy applies it when it packs the upload, and
# BuildKit applies it again.

# Hymn audio and other large assets: the server does not read them.
full/packages/core/assets

# The deployment's own description.
full/apps/egw-search/infra
full/apps/egw-search/alchemy.*.ts
full/apps/egw-search/test

**/.DS_Store
