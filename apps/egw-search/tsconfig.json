{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "effect-frame/view",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "test/**/*.ts",
    "infra/**/*.ts",
    "alchemy.*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
