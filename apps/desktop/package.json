{
  "name": "@bible/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "agent-tail run --log-dir ../../tmp/logs 'desktop: bun run vite:dev'",
    "vite:dev": "vite",
    "build": "bun run build:renderer && bun run build:main",
    "build:renderer": "vite build",
    "build:main": "bun run scripts/build-main.ts",
    "package": "bun run --cwd ../../packages/core sync:bible --force && bun run build && electron-builder",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node -e \"process.exit(process.env.CI||process.env.RAILWAY_ENVIRONMENT||process.env.SKIP_ELECTRON_REBUILD?0:1)\" || electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@bible/app": "workspace:*",
    "@bible/core": "workspace:*",
    "@effect/sql-sqlite-node": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/web": "catalog:",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "vite": "^8.1.4",
    "vite-plugin-solid": "catalog:",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.bible.desktop",
    "productName": "EGW Reader",
    "directories": {
      "output": "dist/release"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": [
          "icon.png"
        ]
      },
      {
        "from": "../../packages/core/data/bible.db",
        "to": "data/bible.db"
      }
    ],
    "mac": {
      "category": "public.app-category.reference",
      "target": "dmg",
      "icon": "assets/icon.icns"
    }
  }
}
