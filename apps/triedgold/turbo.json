{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "app/**",
        "src/**/*.ts",
        "public/**",
        "react-router.config.ts",
        "vite.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["build/**"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  }
}
