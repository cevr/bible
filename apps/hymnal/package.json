{
  "name": "@bible/hymnal-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "one patch || true",
    "dev": "one dev",
    "ios": "one run:ios",
    "android": "one run:android",
    "build": "one build",
    "prebuild:native": "bun vite/prebuild.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.infra.json",
    "test": "bun run test:browser & browser=$!; bun run test:app && bun run test:infra; rest=$?; wait $browser && exit $rest",
    "test:app": "bun test --preload ./src/test/setup.ts src",
    "test:browser": "bun test ./test/browser --timeout 30000",
    "test:infra": "bun test infra scripts",
    "sim": "bun scripts/sim.ts",
    "plan": "alchemy plan alchemy.run.ts --stage prod",
    "deploy": "alchemy deploy alchemy.run.ts --stage prod",
    "audio:copy": "bun infra/audio/copy.ts"
  },
  "dependencies": {
    "@bible/hymnal": "workspace:*",
    "@effect/atom-react": "catalog:",
    "@legendapp/list": "3.6.0",
    "@react-navigation/native": "8.0.0-alpha.51",
    "effect": "catalog:",
    "one": "2.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "3.4.0",
    "react-native-reanimated": "4.7.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@distilled.cloud/cloudflare": "1.0.0-rc.15",
    "@distilled.cloud/core": "1.0.0-rc.15",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@happy-dom/global-registrator": "21.0.3",
    "@playwright/test": "1.64.0",
    "@react-native-community/template": "0.88.0",
    "@types/react": "19.3.0",
    "alchemy": "2.0.0-beta.83",
    "effect-bun-test": "catalog:",
    "vite": "8.3.4"
  }
}
