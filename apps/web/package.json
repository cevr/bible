{
  "name": "@bible/web",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run server:dev\" \"bun run vite:dev\"",
    "vite:dev": "vite",
    "server:dev": "bun --watch server/main.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production bun server/main.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test server src/workers src/lib src/data",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@bible/api": "workspace:*",
    "@bible/core": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@hookform/resolvers": "^5.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "effect": "catalog:",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.2.0",
    "recharts": "3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "wa-sqlite": "https://github.com/cevr/wa-sqlite.git",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.1.4"
  }
}
