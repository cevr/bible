{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    // The site's build reads the owner's private EGW corpus
    // (~/.bible/egw-paragraphs.db) to link references, so the gate (and CI)
    // leaves it out: its output ships committed in dist/, and `bun run build`
    // here publishes a content change.
    "gate": {
      "dependsOn": ["typecheck", "test"]
    }
  }
}
