{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'dist/ is prebuilt and committed — run `bun run build` locally'"
  },
  "deploy": {
    "startCommand": "bun run packages/web/src/server.ts",
    "restartPolicyType": "ON_FAILURE"
  }
}
