{
  "name": "@bible/app",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./application": "./src/application/index.ts",
    "./cache": "./src/cache/index.ts",
    "./platform": "./src/platform/index.ts",
    "./procedure": "./src/procedure/index.ts",
    "./route": "./src/route/index.ts",
    "./runtime": "./src/runtime/index.ts",
    "./styles.css": "./src/styles.css",
    "./ui": "./src/ui/index.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun --conditions=browser test",
    "gate": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@bible/core": "workspace:*",
    "@solidjs/router": "catalog:",
    "@solidjs/web": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  }
}
