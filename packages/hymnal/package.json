{
  "name": "@bible/hymnal",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./chord": "./src/chord.ts",
    "./hymn": "./src/hymn.ts",
    "./recordings": "./src/recordings.ts",
    "./recording-manifest": "./src/recording-manifest.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "test": "bun test --path-ignore-patterns='**/*.slow.test.*'",
    "test:slow": "bun test .slow.test.",
    "align": "bun scripts/align.ts",
    "chart": "bun scripts/chart.ts",
    "census": "bun scripts/census.ts",
    "compile": "bun scripts/compile.ts",
    "golden": "bun scripts/golden.ts",
    "render": "bun scripts/render/render.ts",
    "split": "bun scripts/split.ts"
  },
  "dependencies": {
    "cmu-pronouncing-dictionary": "3.0.0",
    "effect": "catalog:",
    "syllable": "5.0.1"
  },
  "devDependencies": {
    "@bible/core": "workspace:*",
    "@bible/film": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "effect-bun-test": "catalog:",
    "node-av": "6.1.1"
  }
}
