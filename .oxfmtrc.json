{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc/oxfmt/npm/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "ignorePatterns": [
    "apps/selah/Sources/SelahApp/Resources/kjv.json",
    "apps/animations/src/films/*/board.json"
  ]
}
